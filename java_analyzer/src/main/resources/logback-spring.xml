<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="ARGUS_JAVA_LOG_DIR"
              value="${ARGUS_JAVA_LOG_DIR:-${user.dir}/../outputs/logs/runtime/java}"/>
    <property name="ARGUS_RUN_ID" value="${ARGUS_RUN_ID:-unknown}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} req=%X{requestId:-} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 结构化 JSON Lines：字段对齐诊断方案 14.2，供 Python FileDiagnosticsLogStore 扫描 -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${ARGUS_JAVA_LOG_DIR}/argus-java.jsonl</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${ARGUS_JAVA_LOG_DIR}/argus-java.%d{yyyy-MM-dd}.%i.jsonl</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>512MB</totalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <charset>UTF-8</charset>
            <layout class="ch.qos.logback.classic.PatternLayout">
                <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","level":"%level","service":"argus-java","component":"java","logger":"%logger","message":"%replace(%msg){'\"','\\\"'}","requestId":"%X{requestId:-}","runId":"${ARGUS_RUN_ID}","thread":"%thread","pid":"${PID:-}"}%n</pattern>
            </layout>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="JSON_FILE"/>
    </root>
</configuration>
