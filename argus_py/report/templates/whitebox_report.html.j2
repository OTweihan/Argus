{% extends "base.html.j2" %}
{% block content %}
{% set status = report.task.status %}
{% set summary = report.summary or report.task.resultSummary or "未记录结果摘要。" %}
{% set raw = report.task.resultJson %}
{% set wb = raw | load_json or {} if raw is string else raw or {} %}
{% set endpoints = wb.endpoints or [] %}
{% set call_graph = wb.callGraph or {} %}
{% set execution_flows = wb.executionFlows or [] %}
{% set clusters = wb.clusters or [] %}
{% set diagnostics = wb.diagnostics or {} %}
{% set findings = report.findings %}
{% set finding_count = findings | length %}
{% set endpoint_count = endpoints | length %}
{% set callgraph_count = call_graph | length %}
{% set flow_count = execution_flows | length %}
{% set cluster_count = clusters | length %}

<header class="report-hero" id="top">
  <div class="hero-inner">
    <div>
      <div class="eyebrow">Argus Whitebox Analysis</div>
      <h1>{{ report.title }}</h1>
      <p class="hero-desc">{{ summary }}</p>
      <div class="hero-status">
        <span class="badge {{ status }}">{{ status }}</span>
        <span class="badge info">端点 {{ endpoint_count }}</span>
        <span class="badge info">调用图节点 {{ callgraph_count }}</span>
        <span class="badge {{ 'success' if finding_count == 0 else 'failed' }}">缺陷 {{ finding_count }}</span>
      </div>
    </div>

    <aside class="hero-meta" aria-label="报告元信息">
      <div class="meta-row">
        <span class="meta-label">报告 ID</span>
        <span class="meta-value">{{ report.reportId }}</span>
      </div>
      <div class="meta-row">
        <span class="meta-label">任务 ID</span>
        <span class="meta-value">{{ report.task.taskId }}</span>
      </div>
      <div class="meta-row">
        <span class="meta-label">生成时间</span>
        <span class="meta-value">{{ report.generatedAt | datetime_short }}</span>
      </div>
    </aside>
  </div>
</header>

<div class="layout">
  <aside class="sidebar">
    <nav class="nav-card" aria-label="报告导航">
      <p class="nav-title">Report Sections</p>
      <a class="nav-link" href="#overview"><span>概览</span><span>01</span></a>
      <a class="nav-link" href="#diagnostics"><span>解析诊断</span><span>02</span></a>
      <a class="nav-link" href="#task"><span>任务信息</span><span>03</span></a>
      <a class="nav-link" href="#endpoints"><span>端点清单</span><span>04</span></a>
      <a class="nav-link" href="#execution-flows"><span>执行流</span><span>05</span></a>
      <a class="nav-link" href="#callgraph"><span>调用图</span><span>06</span></a>
      <a class="nav-link" href="#clusters"><span>功能聚类</span><span>07</span></a>
      <a class="nav-link" href="#findings"><span>代码缺陷</span><span>08</span></a>
      <a class="nav-link" href="#correlation"><span>黑白盒关联</span><span>09</span></a>
    </nav>
  </aside>

  <main class="content">
    <section class="section" id="overview">
      <div class="metrics">
        <div class="metric">
          <span>任务状态</span>
          <strong><span class="badge {{ status }}">{{ status }}</span></strong>
        </div>
        <div class="metric">
          <span>REST 端点</span>
          <strong>{{ endpoint_count }}</strong>
        </div>
        <div class="metric">
          <span>执行流</span>
          <strong>{{ flow_count }}</strong>
        </div>
        <div class="metric">
          <span>调用图节点</span>
          <strong>{{ callgraph_count }}</strong>
        </div>
        <div class="metric">
          <span>功能聚类</span>
          <strong>{{ cluster_count }}</strong>
        </div>
        <div class="metric">
          <span>代码缺陷</span>
          <strong>{{ finding_count }}</strong>
        </div>
        <div class="metric">
          <span>调用解析</span>
          <strong>{{ diagnostics.get("resolvedHigh", 0) + diagnostics.get("resolvedMedium", 0) }}/{{ diagnostics.get("totalCalls", 0) }}</strong>
        </div>
        <div class="metric">
          <span>解析失败</span>
          <strong>{{ diagnostics.get("failedFileCount", 0) }} files</strong>
        </div>
        <div class="metric">
          <span>Classpath</span>
          <strong>
            {% if diagnostics.get("classpathAvailable", False) %}
              <span style="color: #22c55e;">{{ diagnostics.get("jarCount", 0) }} jars</span>
            {% else %}
              <span style="color: #64748b;">不可用</span>
            {% endif %}
          </strong>
        </div>
        <div class="metric">
          <span>分析范围</span>
          <strong><span class="badge info">{{ wb.summary.scope if wb.summary else "all" }}</span></strong>
        </div>
      </div>
    </section>

    <section class="section card" id="diagnostics">
      <div class="section-head">
        <div>
          <h2>解析诊断</h2>
          <p class="section-subtitle">文件解析与调用图解析质量统计。</p>
        </div>
        <span class="badge info">diagnostics</span>
      </div>

      <table class="info-table">
        <tr>
          <th>源文件</th>
          <td>{{ diagnostics.get("parsedFileCount", 0) }} / {{ diagnostics.get("totalSourceFiles", 0) }} 解析成功
            {% if diagnostics.get("failedFileCount", 0) > 0 %}
              <br>
              <details>
                <summary style="color: #e11d48; cursor: pointer;">{{ diagnostics.get("failedFileCount", 0) }} 个文件解析失败</summary>
                <ul>
                  {% for ff in diagnostics.get("failedFiles", []) %}
                    <li><code>{{ ff.file }}</code>
                      <ul>
                        {% for prob in ff.problems %}
                          <li style="font-size: 0.85em; color: #64748b;">{{ prob }}</li>
                        {% endfor %}
                      </ul>
                    </li>
                  {% endfor %}
                </ul>
              </details>
            {% endif %}
          </td>
        </tr>
        <tr>
          <th>调用解析</th>
          <td>
            总计 {{ diagnostics.get("totalCalls", 0) }} 个调用 —
            高置信度 {{ diagnostics.get("resolvedHigh", 0) }}，
            中置信度 {{ diagnostics.get("resolvedMedium", 0) }}，
            低置信度 {{ diagnostics.get("resolvedLow", 0) }}，
            <strong style="color: {{ '#e11d48' if diagnostics.get('unresolved', 0) > 0 else '#22c55e' }};">
              未解析 {{ diagnostics.get("unresolved", 0) }}
            </strong>
          </td>
        </tr>
        <tr>
          <th>Classpath</th>
          <td>
            {% if diagnostics.get("classpathAvailable", False) %}
              <span style="color: #22c55e;">可用</span> —
              来源 {{ diagnostics.get("classpathSource", "?") }}，
              {{ diagnostics.get("jarCount", 0) }} 个 JAR
              {% if diagnostics.get("classpathWarnings", []) %}
                <br>
                <details>
                  <summary style="color: #eab308; cursor: pointer;">
                    {{ diagnostics.get("classpathWarnings", []) | length }} 个警告
                  </summary>
                  <ul>
                    {% for w in diagnostics.get("classpathWarnings", []) %}
                      <li style="font-size: 0.85em; color: #64748b;">{{ w }}</li>
                    {% endfor %}
                  </ul>
                </details>
              {% endif %}
              {% if diagnostics.get("classpathErrors", []) %}
                <br>
                <details>
                  <summary style="color: #e11d48; cursor: pointer;">
                    {{ diagnostics.get("classpathErrors", []) | length }} 个错误
                  </summary>
                  <ul>
                    {% for e in diagnostics.get("classpathErrors", []) %}
                      <li style="font-size: 0.85em; color: #e11d48;">{{ e }}</li>
                    {% endfor %}
                  </ul>
                </details>
              {% endif %}
            {% else %}
              <span style="color: #64748b;">不可用</span>
              {% if diagnostics.get("classpathErrors", []) %}
                — {{ diagnostics.get("classpathErrors", []) | first }}
              {% endif %}
            {% endif %}
          </td>
        </tr>
      </table>
    </section>

    <section class="section card" id="task">
      <div class="section-head">
        <div>
          <h2>任务信息</h2>
          <p class="section-subtitle">分析源码路径、分支与执行结果。</p>
        </div>
        <span class="badge {{ status }}">{{ status }}</span>
      </div>

      <table class="info-table">
        <tr>
          <th>任务 ID</th>
          <td><code>{{ report.task.taskId }}</code></td>
        </tr>
        <tr>
          <th>结果摘要</th>
          <td>{{ summary }}</td>
        </tr>
        <tr>
          <th>报告路径</th>
          <td>{{ report.task.reportPath or "" }}</td>
        </tr>
        <tr>
          <th>错误信息</th>
          <td>
            {% if report.task.errorMessage %}
              {{ report.task.errorMessage }}
            {% else %}
              <span class="muted">无</span>
            {% endif %}
          </td>
        </tr>
        <tr>
          <th>创建时间</th>
          <td>{{ report.task.createdAt | datetime_short }}</td>
        </tr>
        <tr>
          <th>开始时间</th>
          <td>{{ report.task.startedAt | datetime_short }}</td>
        </tr>
        <tr>
          <th>完成时间</th>
          <td>{{ report.task.completedAt | datetime_short }}</td>
        </tr>
      </table>
    </section>

    <section class="section card" id="endpoints">
      <div class="section-head">
        <div>
          <h2>端点清单</h2>
          <p class="section-subtitle">扫描到的 Controller REST 端点。</p>
        </div>
        <span class="badge info">{{ endpoint_count }} endpoints</span>
      </div>

      {% if endpoints %}
        <table class="info-table">
          <thead>
            <tr>
              <th>HTTP 方法</th>
              <th>路径</th>
              <th>Controller</th>
              <th>方法</th>
              <th>参数</th>
              <th>返回类型</th>
            </tr>
          </thead>
          <tbody>
            {% for ep in endpoints %}
              <tr>
                <td><span class="badge info">{{ ep.httpMethod or "ANY" }}</span></td>
                <td><code>{{ ep.path }}</code></td>
                <td>{{ ep.controllerClass }}</td>
                <td><code>{{ ep.controllerMethod }}</code></td>
                <td>
                  {% if ep.parameters %}
                    {{ ep.parameters | join(", ") }}
                  {% else %}
                    <span class="muted">无</span>
                  {% endif %}
                </td>
                <td><code>{{ ep.returnType }}</code></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <div class="empty-state">
          <div>
            <strong>未发现 REST 端点</strong>
            <span>未扫描到 @RestController 或 @RequestMapping 注解。</span>
          </div>
        </div>
      {% endif %}
    </section>

    <section class="section card" id="execution-flows">
      <div class="section-head">
        <div>
          <h2>执行流</h2>
          <p class="section-subtitle">从 Controller 入口出发的完整调用链追踪。</p>
        </div>
        <span class="badge info">{{ flow_count }} flows</span>
      </div>

      {% if execution_flows %}
        {% for flow in execution_flows %}
          <details class="flow-card" {% if loop.first %}open{% endif %}>
            <summary>
              <strong>{{ flow.entryPoint }}</strong>
              <span class="badge info">深度 {{ flow.callDepth }}</span>
            </summary>
            <div class="flow-tree">
              {% for step in flow.steps %}
                <div class="flow-step" style="padding-left: {{ step.depth * 24 }}px;">
                  <span class="flow-depth-indicator">{{ step.depth }}</span>
                  <code>{{ step.methodKey }}</code>
                </div>
              {% endfor %}
            </div>
          </details>
        {% endfor %}
      {% else %}
        <div class="empty-state">
          <div>
            <strong>未生成执行流</strong>
            <span>分析范围未包含执行流或 Controller 端点无调用链。</span>
          </div>
        </div>
      {% endif %}
    </section>

    <section class="section card" id="callgraph">
      <div class="section-head">
        <div>
          <h2>调用图</h2>
          <p class="section-subtitle">Controller → Service → Repository 方法调用关系。</p>
        </div>
        <span class="badge info">{{ callgraph_count }} nodes</span>
      </div>

      {% if call_graph %}
        <table class="info-table">
          <thead>
            <tr>
              <th>节点</th>
              <th>签名</th>
              <th>被调用方法</th>
            </tr>
          </thead>
          <tbody>
            {% for key, node in call_graph.items() %}
              <tr>
                <td><code>{{ key }}</code></td>
                <td><code>{{ node.methodSignature }}</code></td>
                <td>
                  {% if node.calleeDetails %}
                    {% for callee in node.calleeDetails %}
                      <code>{{ callee.to }}</code>
                      <span class="badge {{ 'success' if callee.confidence == 'HIGH' else 'info' if callee.confidence == 'MEDIUM' else 'failed' }}">{{ callee.resolutionType }}</span>
                      {% if not loop.last %}<br>{% endif %}
                    {% endfor %}
                  {% else %}
                    <span class="muted">无</span>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <div class="empty-state">
          <div>
            <strong>未生成调用图</strong>
            <span>分析范围未包含调用图或项目中无法建立调用链。</span>
          </div>
        </div>
      {% endif %}
    </section>

    <section class="section card" id="clusters">
      <div class="section-head">
        <div>
          <h2>功能聚类</h2>
          <p class="section-subtitle">基于调用关系的功能模块自动分组。</p>
        </div>
        <span class="badge info">{{ cluster_count }} clusters</span>
      </div>

      {% if clusters %}
        <div class="clusters-grid">
          {% for cluster in clusters %}
            <details class="cluster-card">
              <summary>
                <strong>{{ cluster.suggestedLabel }}</strong>
                <span class="badge info">{{ cluster.memberCount }} members</span>
              </summary>
              <ul class="cluster-members">
                {% for member in cluster.memberKeys %}
                  <li><code>{{ member }}</code></li>
                {% endfor %}
              </ul>
            </details>
          {% endfor %}
        </div>
      {% else %}
        <div class="empty-state">
          <div>
            <strong>未生成功能聚类</strong>
            <span>分析范围未包含聚类或调用图为空。</span>
          </div>
        </div>
      {% endif %}
    </section>

    <section class="section card" id="findings">
      <div class="section-head">
        <div>
          <h2>代码缺陷</h2>
          <p class="section-subtitle">静态分析发现的代码坏味道、安全风险和潜在缺陷。</p>
        </div>
        <span class="badge {{ 'success' if finding_count == 0 else 'failed' }}">{{ finding_count }} findings</span>
      </div>

      {% if findings %}
        <div class="timeline">
          {% for finding in findings %}
            <article class="step result-{{ finding.severity }}" id="finding-{{ loop.index }}" data-step="{{ loop.index }}">
              <div class="finding-head">
                <div>
                  <div class="step-title">
                    <h3>{{ finding.title }}</h3>
                    <span class="action-pill">{{ finding.findingType }}</span>
                  </div>
                  <p class="muted">{{ finding.description }}</p>
                </div>
                <span class="badge {{ finding.severity }}">{{ finding.severity }}</span>
              </div>

              <div class="step-body">
                <table class="info-table">
                  <tr>
                    <th>问题 ID</th>
                    <td><code>{{ finding.findingId }}</code></td>
                  </tr>
                  <tr>
                    <th>规则 ID</th>
                    <td><code>{{ finding.ruleId or "-" }}</code></td>
                  </tr>
                  <tr>
                    <th>规则类别</th>
                    <td>{{ finding.ruleCategory or "-" }}</td>
                  </tr>
                  <tr>
                    <th>类型</th>
                    <td>{{ finding.findingType }}</td>
                  </tr>
                  <tr>
                    <th>置信度</th>
                    <td>{{ finding.confidence or "-" }}</td>
                  </tr>
                  <tr>
                    <th>位置</th>
                    <td>{{ finding.location or "" }}</td>
                  </tr>
                  {% if finding.snippet %}
                  <tr>
                    <th>代码片段</th>
                    <td><pre class="snippet-block"><code>{{ finding.snippet }}</code></pre></td>
                  </tr>
                  {% endif %}
                  <tr>
                    <th>时间</th>
                    <td>{{ finding.createdAt | datetime_short }}</td>
                  </tr>
                </table>
              </div>
            </article>
          {% endfor %}
        </div>
      {% else %}
        <div class="empty-state">
          <div>
            <strong>未发现代码缺陷</strong>
            <span>代码质量良好，未检测到明显坏味道或安全问题。</span>
          </div>
        </div>
      {% endif %}
    </section>

    <section class="section card" id="correlation">
      <div class="section-head">
        <div>
          <h2>黑白盒关联</h2>
          <p class="section-subtitle">黑盒请求与白盒端点的匹配证据（关联运行完成后刷新）。</p>
        </div>
        {% if report.correlation %}
          <span class="badge info">{{ report.correlation.aggregate.runCount }} runs</span>
        {% else %}
          <span class="badge info">等待关联</span>
        {% endif %}
      </div>

      {% if report.correlation %}
        {% set corr = report.correlation %}
        {% set agg = corr.aggregate %}
        <div class="metrics">
          <div class="metric">
            <span>关联运行</span>
            <strong>{{ agg.runCount }}</strong>
          </div>
          <div class="metric">
            <span>确认触达端点</span>
            <strong>{{ agg.confirmedTouchedEndpointCount }}</strong>
          </div>
          <div class="metric">
            <span>未覆盖端点</span>
            <strong>{{ agg.uncoveredEndpointCount }}</strong>
          </div>
          <div class="metric">
            <span>确认匹配请求</span>
            <strong>{{ agg.confirmedMatchedRequestCount }}</strong>
          </div>
          <div class="metric">
            <span>未匹配请求</span>
            <strong>{{ agg.unmatchedRequestCount }}</strong>
          </div>
          <div class="metric">
            <span>关联缺陷</span>
            <strong>{{ agg.confirmedRelatedFindingCount }}</strong>
          </div>
          <div class="metric">
            <span>证据完整性</span>
            <strong>
              {% if agg.evidenceCompleteness == 'COMPLETE' %}
                <span style="color: #22c55e;">COMPLETE</span>
              {% else %}
                <span style="color: #eab308;">{{ agg.evidenceCompleteness }}</span>
              {% endif %}
            </strong>
          </div>
        </div>

        {% if corr.runs %}
          <details class="flow-card" {% if loop is defined and loop.first %}open{% endif %}>
            <summary>
              <strong>关联运行明细</strong>
              <span class="badge info">{{ corr.runs | length }} runs</span>
            </summary>
            <table class="info-table">
              <thead>
                <tr>
                  <th>关联运行 ID</th>
                  <th>状态</th>
                  <th>源码对齐</th>
                  <th>采集/可关联/确认匹配/未匹配</th>
                  <th>完整性</th>
                </tr>
              </thead>
              <tbody>
                {% for run in corr.runs %}
                  <tr>
                    <td><code>{{ run.correlationRunId }}</code></td>
                    <td><span class="badge {{ run.status }}">{{ run.status }}</span></td>
                    <td><span class="badge info">{{ run.sourceAlignmentStatus }}</span></td>
                    <td>
                      {{ run.summary.capturedRequestCount if run.summary else "-" }} /
                      {{ run.summary.correlatableRequestCount if run.summary else "-" }} /
                      {{ run.summary.confirmedMatchedRequestCount if run.summary else "-" }} /
                      {{ run.summary.unmatchedRequestCount if run.summary else "-" }}
                    </td>
                    <td>{{ run.summary.evidenceCompleteness if run.summary else "-" }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </details>
        {% endif %}

        <div class="section-head">
          <div>
            <h3 style="margin: 0;">确认触达端点</h3>
          </div>
          <span class="badge success">{{ corr.touchedEndpoints | length }} endpoints</span>
        </div>
        {% if corr.touchedEndpoints %}
          {% for ep in corr.touchedEndpoints %}
            <details class="flow-card" {% if loop.first %}open{% endif %}>
              <summary>
                <strong>{{ ep.httpMethod }} {{ ep.path }}</strong>
                <span class="badge success">{{ ep.confirmedRequestCount }} req</span>
                {% if ep.flows %}
                  <span class="badge info">{{ ep.flows | length }} flows</span>
                {% endif %}
              </summary>
              <table class="info-table">
                <tr>
                  <th>Controller</th>
                  <td>{{ ep.controllerClass or "-" }}.{{ ep.controllerMethod or "-" }}</td>
                </tr>
                <tr>
                  <th>返回类型</th>
                  <td><code>{{ ep.returnType or "-" }}</code></td>
                </tr>
                {% if ep.runIds %}
                  <tr>
                    <th>关联运行</th>
                    <td>{% for rid in ep.runIds %}<code>{{ rid }}</code>{% if not loop.last %}；{% endif %}{% endfor %}</td>
                  </tr>
                {% endif %}
              </table>
              {% if ep.flows %}
                {% for flow in ep.flows %}
                  <details class="flow-card">
                    <summary>
                      <strong>{{ flow.entryPoint }}</strong>
                      <span class="badge info">深度 {{ flow.callDepth }}</span>
                    </summary>
                    <div class="flow-tree">
                      {% for step in flow.steps %}
                        <div class="flow-step" style="padding-left: {{ step.depth * 24 }}px;">
                          <span class="flow-depth-indicator">{{ step.depth }}</span>
                          <code>{{ step.className or "-" }}.{{ step.methodName or step.methodKey }}</code>
                        </div>
                      {% endfor %}
                    </div>
                  </details>
                {% endfor %}
              {% endif %}
            </details>
          {% endfor %}
        {% else %}
          <div class="empty-state">
            <div>
              <strong>尚无确认触达端点</strong>
              <span>黑盒任务未确认命中任何白盒端点。</span>
            </div>
          </div>
        {% endif %}

        <div class="section-head">
          <div>
            <h3 style="margin: 0;">未覆盖端点</h3>
          </div>
          <span class="badge info">{{ corr.uncoveredEndpoints | length }} endpoints</span>
        </div>
        {% if corr.uncoveredEndpoints %}
          <table class="info-table">
            <thead>
              <tr>
                <th>HTTP 方法</th>
                <th>路径</th>
                <th>Controller</th>
                <th>方法</th>
                <th>返回类型</th>
              </tr>
            </thead>
            <tbody>
              {% for ep in corr.uncoveredEndpoints %}
                <tr>
                  <td><span class="badge info">{{ ep.httpMethod }}</span></td>
                  <td><code>{{ ep.path }}</code></td>
                  <td>{{ ep.controllerClass or "-" }}</td>
                  <td><code>{{ ep.controllerMethod or "-" }}</code></td>
                  <td><code>{{ ep.returnType or "-" }}</code></td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <div class="empty-state">
            <div>
              <strong>所有白盒端点均已触达</strong>
              <span>未发现未覆盖端点。</span>
            </div>
          </div>
        {% endif %}

        <div class="section-head">
          <div>
            <h3 style="margin: 0;">未匹配请求</h3>
          </div>
          <span class="badge info">{{ corr.unmatchedRequests | length }} requests</span>
        </div>
        {% if corr.unmatchedRequests %}
          <table class="info-table">
            <thead>
              <tr>
                <th>HTTP 方法</th>
                <th>请求路径</th>
                <th>来源</th>
                <th>状态码</th>
                <th>请求方</th>
              </tr>
            </thead>
            <tbody>
              {% for req in corr.unmatchedRequests %}
                <tr>
                  <td><span class="badge info">{{ req.httpMethod }}</span></td>
                  <td><code>{{ req.displayPath }}</code></td>
                  <td>{{ req.origin or "-" }}</td>
                  <td>{{ req.responseStatus if req.responseStatus is not none else "-" }}</td>
                  <td>{{ req.requestOwner }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <div class="empty-state">
            <div>
              <strong>无未匹配请求</strong>
              <span>所有可关联请求均已匹配到端点。</span>
            </div>
          </div>
        {% endif %}

        {% if corr.findingRelations %}
          <div class="section-head">
            <div>
              <h3 style="margin: 0;">发现项关联</h3>
            </div>
            <span class="badge success">{{ corr.findingRelations | length }} findings</span>
          </div>
          <table class="info-table">
            <thead>
              <tr>
                <th>缺陷</th>
                <th>严重级别</th>
                <th>关系</th>
                <th>确认请求数</th>
              </tr>
            </thead>
            <tbody>
              {% for fr in corr.findingRelations %}
                <tr>
                  <td>
                    {{ fr.title }}
                    {% if fr.ruleId %}<br><code>{{ fr.ruleId }}</code>{% endif %}
                    {% if fr.location %}<br><span class="muted">{{ fr.location }}</span>{% endif %}
                  </td>
                  <td><span class="badge {{ fr.severity }}">{{ fr.severity }}</span></td>
                  <td>{{ fr.bestRelationType }}</td>
                  <td>{{ fr.confirmedRequestCount }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% endif %}
      {% else %}
        <div class="empty-state">
          <div>
            <strong>暂无关联数据</strong>
            <span>关联运行在黑盒任务完成后生成；当有黑盒任务与该分析关联时将在此展示端点触达与请求证据。</span>
          </div>
        </div>
      {% endif %}
    </section>
  </main>
</div>
{% endblock %}
